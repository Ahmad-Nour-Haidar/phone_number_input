# Files that `dart pub publish` leaves out of the package.
#
# This file replaces .gitignore when publishing, so it repeats everything
# that must not be published.

# Build and tool output
.dart_tool/
build/
pubspec.lock
.flutter-plugins
.flutter-plugins-dependencies
*.log

# IDE and OS files
.idea/
.vscode/
*.iml
*.ipr
*.iws
.DS_Store

# Repository files
.github/
helper.txt

# The example's platform projects: pub.dev shows only example/lib/main.dart,
# and the folders are recreated with `flutter create .`.
example/android/
example/ios/
example/linux/
example/macos/
example/web/
example/windows/
